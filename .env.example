# Upstream (Z.ai GLM). GLM_HOST already contains the /v4 prefix.
GLM_HOST=https://api.z.ai/api/coding/paas/v4
GLM_KEY=

# Client-facing key. If set, callers must send Authorization: Bearer <this>.
# Leave empty to keep the proxy open (not recommended on the public internet).
PROXY_API_KEY=

# Local server only (Vercel sets PORT itself).
PORT=3000
# On Vercel Hobby keep this <= 300000 (maxDuration 300s).
UPSTREAM_TIMEOUT_MS=600000
MAX_BODY_BYTES=10485760
LOG_LEVEL=info
